# Database
ALAS_DB_NAME=alas
ALAS_DB_USER=alas_user
ALAS_DB_PASSWORD=change-this-strong-password
DATABASE_URL=postgresql://alas_user:${ALAS_DB_PASSWORD}@alas-db:5432/alas

# Service Auth (HARUS SAMA dengan ALAS_SERVICE_TOKEN di Lawet Hub)
ALAS_SERVICE_TOKEN=change-this-generate-openssl-rand-hex-32

# Integration URLs
NEXT_PUBLIC_LAWET_HUB_ADMIN_URL=https://lawethub.pusdakum.web.id/superadmin/jurnal-alas

# Sentry config (Optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
