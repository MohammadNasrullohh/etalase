# Database
ALAS_DB_NAME=alas
ALAS_DB_USER=alas_user
ALAS_DB_PASSWORD=change-this-strong-password
DATABASE_URL=postgresql://alas_user:${ALAS_DB_PASSWORD}@alas-db:5432/alas

# Service Auth (HARUS SAMA dengan ALAS_SERVICE_TOKEN di Lawet Hub)
ALAS_SERVICE_TOKEN=change-this-generate-openssl-rand-hex-32

# Hanya role dengan level ini yang dapat mengubah pengaturan situs/hero.
ALAS_ADMIN_ROLE_LEVEL=3

# Backend API URL (Hanya diakses secara internal oleh Server-Side ALAS ke Server Lawet Hub)
# SANGAT DISARANKAN MENGGUNAKAN JALUR LOKAL (Internal Network) UNTUK PRODUKSI KARENA LEBIH CEPAT & AMAN
# 
# Pilihan Konfigurasi Produksi:
# 1. Jika ALAS dan Lawet dijalankan via Docker Compose di satu server: 
#    LAWET_API_URL=http://lawet-nginx:80
# 2. Jika ALAS dijalankan via PM2 dan Lawet terekspos di port localhost: 
#    LAWET_API_URL=http://127.0.0.1:2002
#
# Client/Browser pengunjung tidak akan pernah tahu URL ini karena diproses oleh Next.js Backend.
LAWET_API_URL=http://127.0.0.1:2002

# Wajib gunakan koneksi PostgreSQL TLS untuk database di luar jaringan lokal.
# DATABASE_URL=postgresql://user:password@db.example:5432/alas?sslmode=require

# Sentry config (Optional)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
